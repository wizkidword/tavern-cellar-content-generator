generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  GENERATED
  READY_FOR_REVIEW
  WP_DRAFT
  PUBLISHED
  SCHEDULED
}

enum PublishOperationState {
  IDLE
  IN_PROGRESS
  SUCCEEDED
  FAILED
  UNCERTAIN
}

enum PublishAttemptState {
  STARTED
  POST_IDENTIFIED
  MEDIA_COMPLETE
  CONTENT_COMPLETE
  SUCCEEDED
  FAILED
  UNCERTAIN
}

enum WordPressSyncMode {
  FULL_PRIVATE
  PUBLIC_ONLY
}

enum WordPressSyncState {
  RUNNING
  SUCCEEDED
  DEGRADED
  FAILED
}

enum ImageOperationState {
  IDLE
  GENERATING
  SUCCEEDED
  FAILED
  CLEANUP_WARNING
}

enum ContentOpportunityStatus {
  IDEA
  APPROVED
  GENERATED
  REJECTED
  ARCHIVED
}

enum TopicClusterItemType {
  SITE_POST
  ARTICLE
  OPPORTUNITY
}

model Category {
  id                   Int                  @id @default(autoincrement())
  wpCategoryId         Int                  @unique
  name                 String
  slug                 String               @unique
  description          String?
  isActive             Boolean              @default(false)
  postCount            Int                  @default(0)
  lastSeenSyncRunId    String?
  lastSeenAt           DateTime?
  isStale              Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  articles             Article[]
  sitePosts            SitePost[]
  contentOpportunities ContentOpportunity[]
  topicClusters        TopicCluster[]
}

model SitePost {
  id                String    @id @default(cuid())
  wpPostId          Int       @unique
  title             String
  normalizedTitle   String
  slug              String    @unique
  excerpt           String?
  canonicalTopicKey String
  wpStatus          String    @default("publish")
  publishedAt       DateTime?
  link              String?
  primaryCategoryId Int?
  rawCategoryIds    String
  lastSyncedAt      DateTime  @default(now())
  lastSeenSyncRunId String?
  lastSeenAt        DateTime?
  isStale           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  primaryCategory          Category?                 @relation(fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  opportunityInternalLinks OpportunityInternalLink[]
  opportunitySimilarPosts  OpportunitySimilarPost[]
  topicClusterItems        TopicClusterItem[]

  @@index([primaryCategoryId])
  @@index([canonicalTopicKey])
  @@index([normalizedTitle])
  @@index([isStale])
}

model Article {
  id                                     String        @id @default(cuid())
  title                                  String
  normalizedTitle                        String
  angle                                  String
  normalizedAngle                        String
  primaryKeyword                         String
  normalizedKeyword                      String
  canonicalTopicKey                      String
  slug                                   String
  notes                                  String?
  contentMarkdown                        String
  metaTitle                              String
  metaDescription                        String
  excerpt                                String
  tags                                   String
  internalLinks                          String
  featuredImagePrompt                    String
  featuredImageAlt                       String
  featuredImagePath                      String?
  featuredImageMimeType                  String?
  featuredImageState                     ImageOperationState @default(IDLE)
  featuredImageErrorCode                 String?
  featuredImageLastAttemptAt             DateTime?
  bodyImagesState                        ImageOperationState @default(IDLE)
  bodyImagesErrorCode                    String?
  bodyImagesLastAttemptAt                DateTime?
  bodyImagesOperationKey                 String?
  wpMediaId                              Int?
  openAiTextModel                        String
  openAiImageModel                       String?
  categoryId                             Int
  status                                 ArticleStatus @default(GENERATED)
  publishState                           PublishOperationState @default(IDLE)
  activePublishOperationKey              String?       @unique
  wpPostId                               Int?          @unique
  wpStatus                               String?
  scheduledFor                           DateTime?
  scheduledForLocal                      String?
  scheduledForTimezone                   String?
  publishedAt                            DateTime?
  qualityWordCount                       Int           @default(0)
  qualityHeadingCount                    Int           @default(0)
  qualityMetaTitleLength                 Int           @default(0)
  qualityMetaDescriptionLength           Int           @default(0)
  qualityInternalLinkCount               Int           @default(0)
  qualityFocusKeyphraseInTitle           Boolean       @default(false)
  qualityFocusKeyphraseInOpening         Boolean       @default(false)
  qualityFocusKeyphraseInMetaDescription Boolean       @default(false)
  qualityWarnings                        String        @default("[]")
  createdAt                              DateTime      @default(now())
  updatedAt                              DateTime      @updatedAt

  category                Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bodyImages              ArticleBodyImage[]
  contentOpportunities    ContentOpportunity[]
  modelComparisons        ArticleModelComparison[]
  publishAttempts         PublishAttempt[]
  opportunitySimilarPosts OpportunitySimilarPost[]
  topicClusterItems       TopicClusterItem[]

  @@unique([categoryId, canonicalTopicKey])
  @@unique([categoryId, slug])
  @@index([status])
  @@index([normalizedTitle])
  @@index([normalizedKeyword])
  @@index([publishState])
}

model PublishAttempt {
  id                  String              @id @default(cuid())
  articleId           String
  operationKey        String              @unique
  desiredWpStatus     String
  state               PublishAttemptState @default(STARTED)
  wpPostId            Int?
  lastCheckpoint      String?
  errorCode           String?
  errorCorrelationId  String?
  errorDetailInternal String?
  warningCode         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, updatedAt])
  @@index([state])
}

model WordPressSyncRun {
  id                 String             @id @default(cuid())
  mode               WordPressSyncMode
  state              WordPressSyncState @default(RUNNING)
  startedAt          DateTime           @default(now())
  completedAt        DateTime?
  postCount          Int                @default(0)
  categoryCount      Int                @default(0)
  pageCount          Int                @default(0)
  errorCode          String?
  errorCorrelationId String?
  siteTimezone       String?
  siteUrl            String

  @@index([state, startedAt])
  @@index([mode, completedAt])
}

model ArticleBodyImage {
  id             String   @id @default(cuid())
  articleId      String
  prompt         String
  altText        String
  sectionHeading String
  sortOrder      Int
  publicPath     String
  assetKey       String?  @unique
  mimeType       String   @default("image/png")
  imageModel     String
  wpMediaId      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, sortOrder])
  @@index([articleId])
}

model ArticleModelComparison {
  id                                     String   @id @default(cuid())
  sourceArticleId                        String
  openAiTextModel                        String
  title                                  String
  angle                                  String
  primaryKeyword                         String
  slug                                   String
  contentMarkdown                        String
  metaTitle                              String
  metaDescription                        String
  excerpt                                String
  tags                                   String
  internalLinks                          String
  featuredImagePrompt                    String
  featuredImageAlt                       String
  qualityWordCount                       Int      @default(0)
  qualityHeadingCount                    Int      @default(0)
  qualityMetaTitleLength                 Int      @default(0)
  qualityMetaDescriptionLength           Int      @default(0)
  qualityInternalLinkCount               Int      @default(0)
  qualityFocusKeyphraseInTitle           Boolean  @default(false)
  qualityFocusKeyphraseInOpening         Boolean  @default(false)
  qualityFocusKeyphraseInMetaDescription Boolean  @default(false)
  qualityWarnings                        String   @default("[]")
  createdAt                              DateTime @default(now())
  updatedAt                              DateTime @updatedAt

  sourceArticle Article @relation(fields: [sourceArticleId], references: [id], onDelete: Cascade)

  @@unique([sourceArticleId, openAiTextModel])
  @@index([sourceArticleId])
  @@index([openAiTextModel])
}

model ContentOpportunity {
  id                   String                   @id @default(cuid())
  categoryId           Int
  primaryKeyword       String
  normalizedKeyword    String
  angle                String
  normalizedAngle      String
  brief                String
  status               ContentOpportunityStatus @default(IDEA)
  tavernFitScore       Int
  coverageScore        Int
  seoScore             Int
  duplicateRiskScore   Int
  internalLinkScore    Int
  publishabilityScore  Int
  categoryBalanceScore Int
  overallScore         Int
  scoreReasons         String
  duplicateRiskLabel   String
  generatedArticleId   String?
  topicClusterId       String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  category          Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  generatedArticle  Article?                  @relation(fields: [generatedArticleId], references: [id], onDelete: SetNull)
  topicCluster      TopicCluster?             @relation(fields: [topicClusterId], references: [id], onDelete: SetNull)
  internalLinks     OpportunityInternalLink[]
  similarPosts      OpportunitySimilarPost[]
  topicClusterItems TopicClusterItem[]

  @@unique([categoryId, normalizedKeyword, normalizedAngle])
  @@index([categoryId])
  @@index([status])
  @@index([overallScore])
}

model OpportunityInternalLink {
  id            String   @id @default(cuid())
  opportunityId String
  sitePostId    String
  reason        String
  confidence    Int
  createdAt     DateTime @default(now())

  opportunity ContentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sitePost    SitePost           @relation(fields: [sitePostId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, sitePostId])
  @@index([sitePostId])
}

model OpportunitySimilarPost {
  id            String   @id @default(cuid())
  opportunityId String
  sitePostId    String?
  articleId     String?
  source        String
  title         String
  status        String
  similarity    Int
  reason        String
  createdAt     DateTime @default(now())

  opportunity ContentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sitePost    SitePost?          @relation(fields: [sitePostId], references: [id], onDelete: SetNull)
  article     Article?           @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([sitePostId])
  @@index([articleId])
  @@index([similarity])
  @@unique([opportunityId, sitePostId])
  @@unique([opportunityId, articleId])
}

model TopicCluster {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  description    String
  categoryId     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category      Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  opportunities ContentOpportunity[]
  items         TopicClusterItem[]

  @@index([categoryId])
}

model TopicClusterItem {
  id             String               @id @default(cuid())
  topicClusterId String
  itemType       TopicClusterItemType
  sitePostId     String?
  articleId      String?
  opportunityId  String?
  label          String
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())

  topicCluster TopicCluster        @relation(fields: [topicClusterId], references: [id], onDelete: Cascade)
  sitePost     SitePost?           @relation(fields: [sitePostId], references: [id], onDelete: Cascade)
  article      Article?            @relation(fields: [articleId], references: [id], onDelete: Cascade)
  opportunity  ContentOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([topicClusterId])
  @@index([itemType])
  @@index([sitePostId])
  @@index([articleId])
  @@index([opportunityId])
  @@unique([topicClusterId, sitePostId])
  @@unique([topicClusterId, articleId])
  @@unique([topicClusterId, opportunityId])
}
