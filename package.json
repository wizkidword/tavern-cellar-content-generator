{
  "name": "tavern-cellar-content-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-foundry.mjs dev",
    "build": "next build",
    "start": "node scripts/start-foundry.mjs",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "test:db": "node scripts/verify-migrations.mjs",
    "release:smoke": "node --import tsx scripts/release-smoke.ts",
    "typecheck": "tsc --noEmit",
    "db:backup": "node scripts/backup-database.mjs",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:push:legacy": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@prisma/client": "^6.19.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.2",
    "next": "16.2.11",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
