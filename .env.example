DATABASE_URL="file:./prisma/dev.db"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_TEXT_MODEL="gpt-5.4-mini"
# Supported GPT Image models: gpt-image-2, gpt-image-1.5, gpt-image-1, gpt-image-1-mini
OPENAI_IMAGE_MODEL="gpt-image-2"
FEATURED_IMAGE_PROVIDER="fal"
FAL_KEY="your-fal-api-key"
FAL_IMAGE_MODEL="fal-ai/flux-2"
FAL_IMAGE_QUALITY="quality"
WORDPRESS_URL="https://taverncellar.com"
WORDPRESS_USERNAME="your-wordpress-username"
WORDPRESS_APP_PASSWORD="your-wordpress-application-password"
# Refresh full private WordPress coverage after this many hours (1-168).
WORDPRESS_SYNC_STALE_HOURS="24"
# Required for the operator login. Use a unique credential of 16+ characters.
FOUNDRY_OPERATOR_TOKEN="replace-with-a-strong-operator-credential"
# Required for signed sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-at-least-32-random-bytes"
SESSION_MAX_AGE_HOURS="12"
APP_ORIGIN="http://127.0.0.1:3000"
# Keep false unless a trusted reverse proxy is explicitly configured.
TRUST_PROXY="false"
